# Copy this file to .env and fill in your own values.
# On Render, enter the same names under Environment instead (no .env file).

# Port the API listens on (Render sets this itself)
PORT=5000

# MySQL connection — Laragon defaults shown. For Aiven, copy Host, Port,
# User, Password and Database from the service's Overview page.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sportpass_db

# Encrypted connection (Aiven requires it). Paste the whole CA certificate
# from Aiven (Overview > CA certificate) into DB_SSL_CA, including the
# -----BEGIN CERTIFICATE----- and -----END CERTIFICATE----- lines.
DB_SSL=false
DB_SSL_CA=

# Philippine time for "today", NOW() and dates in notifications.
DB_TIMEZONE=+08:00
APP_TIMEZONE=Asia/Manila

# The web app's address, so only it can call this API. Several addresses
# can be separated by commas. Leave empty for local development.
CORS_ORIGIN=

# Secret used to sign logins and QR codes. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out and invalidates all QR codes.
JWT_SECRET=change-me-to-a-long-random-value

# Starting values for settings. After the first save on the Settings page,
# the values stored in the database are used instead.
FINE_PER_MISSED_SCAN=30
ACTIVITY_QR_TTL_SECONDS=120
STUDENT_QR_TTL_SECONDS=300
MIN_MINUTES_BEFORE_TIME_OUT=1
